# Copy to .env and edit:  cp .env.example .env
# A fresh clone works with NO .env at all (SQLite file under ./data).

NODE_ENV=development
PORT=3000

# --- Database: pick ONE -------------------------------------------------------
# sqlite   -> zero setup, a single file on disk (default)
# postgres -> your local PostgreSQL (e.g. managed with pgAdmin)
DB_TYPE=sqlite

# Used when DB_TYPE=sqlite. Parent folders are created automatically.
SQLITE_PATH=./data/corridor-finder.sqlite

# Used when DB_TYPE=postgres. Create an empty database in pgAdmin first, then fill these in.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_NAME=corridor_finder
# DB_SSL=false
